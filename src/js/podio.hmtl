<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Podio interactivo de los tres mejores ciclistas de ruta en la actualidad: Tadej Pogačar, Jonas Vingegaard y Remco Evenepoel.">
    <title>Podio de Élite: Los 3 Mejores Ciclistas del Mundo</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Estilos CSS -->
    <link rel="stylesheet" href="../css/podio.css">
</head>

<body>
    <main class="app-container">
        <!-- Cabecera Principal -->
        <header class="header">
            <div class="badge-tag">UCI WorldTour • Ranking Mundial</div>
            <h1>Podio de los 3 Mejores <span>Ciclistas del Mundo</span></h1>
            <p>
                Los monarcas indiscutibles del ciclismo en la actualidad: campeones del Tour de Francia, 
                Giro de Italia, Monumentos y Juegos Olímpicos.
            </p>
        </header>

        <!-- Contenedor del Podio Dinámico (Orden olímpico: 2º - 1º - 3º) -->
        <section class="podium-container" id="podiumContainer" aria-label="Podio de ciclistas">
            <!-- El contenido dinámico se renderiza mediante podio.js -->
            <noscript>
                <p style="color: #fff; text-align: center;">Por favor, activa JavaScript para ver el podio interactivo.</p>
            </noscript>
        </section>

        <!-- Pie Informativo -->
        <footer class="footer-notes">
            <p>🚴 Ciclismo de Ruta Profesional Élite • Temporada Actual</p>
            <p style="margin-top: 6px; font-size: 0.8rem; opacity: 0.7;">Haz clic en cualquier ciclista para leer su trayectoria y palmarés completo.</p>
        </footer>
    </main>

    <!-- Modal para ver Biografía Completa y Palmarés -->
    <div class="modal-overlay" id="bioModal" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="modal-content">
            <button class="modal-close-btn" id="closeModalBtn" aria-label="Cerrar modal">&times;</button>
            
            <div class="modal-hero">
                <img id="modalAvatar" class="modal-avatar" src="" alt="Foto del ciclista">
                <div class="modal-title-area">
                    <h2 id="modalName">Nombre del Ciclista</h2>
                    <div id="modalSubtitle" class="modal-subtitle">Equipo y País</div>
                </div>
            </div>

            <div class="modal-body">
                <h3>📖 Biografía y Trayectoria</h3>
                <p id="modalBio" class="modal-bio-text"></p>

                <h3>🏆 Palmarés Destacado</h3>
                <ul id="modalPalmares" class="palmares-list"></ul>
            </div>
        </div>
    </div>

    <!-- Script de Datos y Funcionalidad -->
    <script src="podio.js"></script>
</body>

</html>
